  <DUT Name="Enum_ModeDepl" Id="{e2db0b58-8a34-4f05-be2c-91aa19972248}">
    <Declaration><![CDATA[TYPE Enum_ModeDepl :
(
	eModeAbs,	//Mode de délpaceemnt absolu, (Va au coordénées données) // 0
	eModeRel,	//Mode de déplacement relatif (Effectue un angle, puis une distance) // 1
