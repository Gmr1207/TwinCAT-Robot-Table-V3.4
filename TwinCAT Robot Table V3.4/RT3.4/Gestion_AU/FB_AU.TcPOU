END_VAR
VAR
	test1: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT Ix_nAU AND NOT Ix_AU_Lidar  THEN
(*GVL_Lidar.zoneSelectionee_GVL[36]:=0;
GVL_Lidar.zoneSelectionee_GVL[1]:=0;
GVL_Lidar.zoneSelectionee_GVL[2]:=0; *)
