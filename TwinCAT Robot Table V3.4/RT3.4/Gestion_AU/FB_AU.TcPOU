<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_AU" Id="{7e4afcd9-1ffa-4017-9310-692af43528c4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AU
