<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_LidarFrame" Id="{bc2577dc-42ec-47d1-b76c-32c061b67e18}">
    <Declaration><![CDATA[TYPE ST_LidarFrame  :
STRUCT
 	SpeedDps     : UINT;                     // °/s
    StartAngle01 : UINT;                     // angle * 100 (0,01°)
    EndAngle01   : UINT;                     // angle * 100 (0,01°)
    DistanceMm   : ARRAY[0..11] OF UINT;     // 12 points
    Intensity    : ARRAY[0..11] OF BYTE;     // 12 points
    AngleDeg     : ARRAY[0..11] OF REAL;     // 12 angles en degrés [0..360)
    TimestampMs  : UINT;                     // timestamp bruts
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>