<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="decodage_lidar" Id="{cba8e06a-69eb-4145-84e1-855f9da12d0a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM decodage_lidar
VAR //CHANGER UNIQUEMENT PORT COM
    //configuration port série
serialCfg : ComSerialConfig := (
    ComPort  := 6,              // COM7 (a configurer)
    Baudrate := 230400,
    Parity   := PARITY_NONE,
    DataBits := 8,
    StopBits := STOPBITS_ONE,
    DTR      := DTR_CTRL_DISABLE,   
    RTS      := RTS_CTRL_DISABLE,   
    CTS      := FALSE,
    DSR      := FALSE,
    TraceLevel := 0
);

Sector10   : ARRAY[0..35] OF ST_Sector10Deg; //les distance par lot de 10° 
 aScan360       : ARRAY[0..359] OF ST_ScanPoint; //toutes les distance (360 point)



    txBuffer : ComBuffer;
    rxBuffer : ComBuffer;

    fbSerial3   : SerialLineControlADS;
    fbRecvData : ReceiveData;

    //reception des donnée brut 
    aRxBlock : ARRAY[0..511] OF BYTE;
    lenRx    : UDINT;

    i, j      : INT;
    pktOfs    : INT;
    dataOfs   : INT;

    //frame décodé
    LidarFrame : ST_LidarFrame;
    NewFrame   : BOOL;

    //distance par °
   
    PrevStartDeg   : REAL := 0.0;
    NewScanReady   : BOOL;
    idx360         : INT;

    MAX_DISTANCE  : UINT := 12000; // 12 m

    //calcul angle
    startDeg  : REAL;
    endDeg    : REAL;
    angleDiff : REAL;
    angleInc  : REAL;

    //secteur de 10°
    
    ind        : INT;                    // index secteur 0..35
    angleIdx   : INT;                    // index angle 0..359
    cnt        : INT;                    // nb de valeurs dans distances[]
    i2, j2     : INT;                    // indices pour le tri
    tmpDist    : UINT;                   
    distances  : ARRAY[0..9] OF UINT;    // max 10 angles par secteur

    //CRC (verification des information)
    crc      : BYTE;
    idxCrc   : BYTE;
    n        : INT;

    //diver
    newDist   : UINT;

    ton1           : TON;
    utilisationLidar : BOOL;
    distanceFreinage : LREAL;
	idxMed : INT;
	dbgSerialBusy  : BOOL;
    dbgSerialError : BOOL;
    dbgSerialErrId : UDINT;
	serialErrId: UDINT;
	serialPortOpened : BOOL;
	angleRad: REAL;
	X : ARRAY[0..359]OF REAL;
	Y : ARRAY[0..359]OF REAL;
	startAngle: INT;
	normalizedAngleIdx: INT;
	Calcul_LIDAR_1: Calcul_LIDAR;
END_VAR

VAR CONSTANT //pour le CRC
    crcTable : ARRAY [0..255] OF BYTE := [
        16#00,16#4D,16#9A,16#D7,16#79,16#34,16#E3,16#AE,
        16#F2,16#BF,16#68,16#25,16#8B,16#C6,16#11,16#5C,
        16#A9,16#E4,16#33,16#7E,16#D0,16#9D,16#4A,16#07,
        16#5B,16#16,16#C1,16#8C,16#22,16#6F,16#B8,16#F5,
        16#1F,16#52,16#85,16#C8,16#66,16#2B,16#FC,16#B1,
        16#ED,16#A0,16#77,16#3A,16#94,16#D9,16#0E,16#43,
        16#B6,16#FB,16#2C,16#61,16#CF,16#82,16#55,16#18,
        16#44,16#09,16#DE,16#93,16#3D,16#70,16#A7,16#EA,
        16#3E,16#73,16#A4,16#E9,16#47,16#0A,16#DD,16#90,
        16#CC,16#81,16#56,16#1B,16#B5,16#F8,16#2F,16#62,
        16#97,16#DA,16#0D,16#40,16#EE,16#A3,16#74,16#39,
        16#65,16#28,16#FF,16#B2,16#1C,16#51,16#86,16#CB,
        16#21,16#6C,16#BB,16#F6,16#58,16#15,16#C2,16#8F,
        16#D3,16#9E,16#49,16#04,16#AA,16#E7,16#30,16#7D,
        16#88,16#C5,16#12,16#5F,16#F1,16#BC,16#6B,16#26,
        16#7A,16#37,16#E0,16#AD,16#03,16#4E,16#99,16#D4,
        16#7C,16#31,16#E6,16#AB,16#05,16#48,16#9F,16#D2,
        16#8E,16#C3,16#14,16#59,16#F7,16#BA,16#6D,16#20,
        16#D5,16#98,16#4F,16#02,16#AC,16#E1,16#36,16#7B,
        16#27,16#6A,16#BD,16#F0,16#5E,16#13,16#C4,16#89,
        16#63,16#2E,16#F9,16#B4,16#1A,16#57,16#80,16#CD,
        16#91,16#DC,16#0B,16#46,16#E8,16#A5,16#72,16#3F,
        16#CA,16#87,16#50,16#1D,16#B3,16#FE,16#29,16#64,
        16#38,16#75,16#A2,16#EF,16#41,16#0C,16#DB,16#96,
        16#42,16#0F,16#D8,16#95,16#3B,16#76,16#A1,16#EC,
        16#B0,16#FD,16#2A,16#67,16#C9,16#84,16#53,16#1E,
        16#EB,16#A6,16#71,16#3C,16#92,16#DF,16#08,16#45,
        16#19,16#54,16#83,16#CE,16#60,16#2D,16#FA,16#B7,
        16#5D,16#10,16#C7,16#8A,16#24,16#69,16#BE,16#F3,
        16#AF,16#E2,16#35,16#78,16#D6,16#9B,16#4C,16#01,
        16#F4,16#B9,16#6E,16#23,16#8D,16#C0,16#17,16#5A,
        16#06,16#4B,16#9C,16#D1,16#7F,16#32,16#E5,16#A8
    ];
END_VAR

VAR CONSTANT
Ir_Taille_Robot : INT := 400 ;	
Ir_variable_secu :LREAL := 1.3 ;


END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[//ouverture du port série
fbSerial3(
    Connect   := TRUE,
    SerialCfg := serialCfg,
    NetId     := '',
    Timeout   := T#2S,
    TxBuffer  := txBuffer,
    RxBuffer  := rxBuffer
);

dbgSerialBusy  := fbSerial3.Busy;
dbgSerialError := fbSerial3.Error;
serialErrId     := fbSerial3.ErrorID;   
serialPortOpened:= fbSerial3.PortOpened;

//Réception brute
fbRecvData(
    pPrefix         := 0,
    LenPrefix       := 0,
    pSuffix         := 0,
    LenSuffix       := 0,
    pReceiveData    := ADR(aRxBlock),
    SizeReceiveData := SIZEOF(aRxBlock),
    Timeout         := T#30MS,
    Reset           := FALSE,
    RxBuffer        := rxBuffer
);

NewFrame     := FALSE;
NewScanReady := FALSE;

//Parsing des trames LD19 
IF fbRecvData.DataReceived THEN
    lenRx := fbRecvData.LenReceiveData;

    IF lenRx >= 47 THEN
        i := 0;
        WHILE i <= TO_INT(lenRx) - 47 DO

            // Detection des en-tête LD19 : 0x54, 0x2C
            IF (aRxBlock[i] = 16#54) AND (aRxBlock[i + 1] = 16#2C) THEN
                pktOfs := i;

                //CRC (verification des information
                crc := 16#D8;
                FOR n := 0 TO 43 DO
                    idxCrc := crc XOR aRxBlock[pktOfs + 2 + n];
                    crc    := crcTable[idxCrc];
                END_FOR;

                IF crc = aRxBlock[pktOfs + 46] THEN
                    //parsing des information
                    LidarFrame.SpeedDps := //vitesse du lidar
                        TO_UINT(aRxBlock[pktOfs + 2]) OR
                        SHL(TO_UINT(aRxBlock[pktOfs + 3]), 8);

                    LidarFrame.StartAngle01 := //angle de départ
                        TO_UINT(aRxBlock[pktOfs + 4]) OR
                        SHL(TO_UINT(aRxBlock[pktOfs + 5]), 8);

                    dataOfs := pktOfs + 6;
                    FOR j := 0 TO 11 DO
                        LidarFrame.DistanceMm[j] := //distance
                            TO_UINT(aRxBlock[dataOfs]) OR
                            SHL(TO_UINT(aRxBlock[dataOfs + 1]), 8);
                        LidarFrame.Intensity[j] := aRxBlock[dataOfs + 2];
                        dataOfs := dataOfs + 3;
                    END_FOR

                    LidarFrame.EndAngle01 := //angle de fin
                        TO_UINT(aRxBlock[pktOfs + 42]) OR
                        SHL(TO_UINT(aRxBlock[pktOfs + 43]), 8);

                    LidarFrame.TimestampMs :=
                        TO_UINT(aRxBlock[pktOfs + 44]) OR
                        SHL(TO_UINT(aRxBlock[pktOfs + 45]), 8);

                    //conversion des angles en degré
                    startDeg := TO_REAL(LidarFrame.StartAngle01) / 100.0;
                    endDeg   := TO_REAL(LidarFrame.EndAngle01)   / 100.0;

                    IF endDeg >= startDeg THEN
                        angleDiff := endDeg - startDeg;
                    ELSE
                        angleDiff := (endDeg + 360.0) - startDeg;
                    END_IF;

                    angleInc := angleDiff / 11.0;

                    FOR j := 0 TO 11 DO
                        LidarFrame.AngleDeg[j] := startDeg + angleInc * TO_REAL(j);
                        IF LidarFrame.AngleDeg[j] >= 360.0 THEN
                            LidarFrame.AngleDeg[j] := LidarFrame.AngleDeg[j] - 360.0;
                        END_IF;
                    END_FOR

                    // Détection nouveau tour (juste pour info)
                    IF LidarFrame.AngleDeg[0] < PrevStartDeg THEN
                        NewScanReady := TRUE;
                    END_IF;
                    PrevStartDeg := LidarFrame.AngleDeg[0];

                    //remplisabe des longeur pour les angle de 1°
                    FOR j := 0 TO 11 DO
                        idx360 := REAL_TO_INT(LidarFrame.AngleDeg[j] + 0.5);
                        IF idx360 < 0 THEN
                            idx360 := 0;
                        ELSIF idx360 > 359 THEN
                            idx360 := idx360 MOD 360;
                        END_IF;

                        newDist := LidarFrame.DistanceMm[j];
                        IF (newDist > 0) AND (newDist <= MAX_DISTANCE) THEN
                            aScan360[idx360].DistanceMm := newDist;
                            aScan360[idx360].Intensity  := LidarFrame.Intensity[j];
                            aScan360[idx360].AngleDeg   := LidarFrame.AngleDeg[j];
                            aScan360[idx360].Valid      := TRUE;
                        END_IF;
                    END_FOR;

                    NewFrame := TRUE;

                    
                    i := i + 47;
                    CONTINUE;   
                END_IF
            END_IF

            // pas d'en-tête ou CRC mauvais → avancer d'un octet 
            i := i + 1;
        END_WHILE
    END_IF
END_IF;

//calcul des medianne pour les angle de 10°
FOR ind := 0 TO 35 DO
    cnt := 0;

    // Calculer l'angle de départ pour ce secteur
    startAngle := (ind * 10) + 355;
    // Normaliser l'angle de départ pour qu'il soit dans la plage [0, 360)
    IF startAngle >= 360 THEN
        startAngle := startAngle - 360;
    ELSIF startAngle < 0 THEN
        startAngle := startAngle + 360;
    END_IF

    // Récupération des distances pour les angles dans le secteur
    FOR angleIdx := startAngle - 5 TO startAngle + 4 DO
        // Normaliser angleIdx pour qu'il soit dans la plage [0, 360)
        normalizedAngleIdx := angleIdx;
        IF normalizedAngleIdx < 0 THEN
            normalizedAngleIdx := normalizedAngleIdx + 360;
        ELSIF normalizedAngleIdx >= 360 THEN
            normalizedAngleIdx := normalizedAngleIdx - 360;
        END_IF

        IF aScan360[normalizedAngleIdx].Valid THEN
            newDist := aScan360[normalizedAngleIdx].DistanceMm;
            IF (newDist > 0) AND (newDist <= MAX_DISTANCE) THEN
                IF cnt < 10 THEN
                    distances[cnt] := newDist;
                    cnt := cnt + 1;
                END_IF;
            END_IF
        END_IF
    END_FOR

    IF cnt > 0 THEN
        // Tri dans l'ordre croissant pour la médiane
        FOR i2 := 0 TO cnt - 2 DO
            FOR j2 := i2 + 1 TO cnt - 1 DO
                IF distances[j2] < distances[i2] THEN
                    tmpDist := distances[i2];
                    distances[i2] := distances[j2];
                    distances[j2] := tmpDist;
                END_IF
            END_FOR
        END_FOR

        idxMed := cnt / 2;   // médiane

        Sector10[ind].MedianDistanceMm := distances[idxMed];
        Sector10[ind].Count := TO_UINT(cnt);
        Sector10[ind].Valid := TRUE;
    END_IF
END_FOR


Calcul_LIDAR_1(
	Distance_Freinage:= Ir_variable_secu , 
	tailleRobot:= Ir_Taille_Robot , 
	accel_Robot:=  GVL_Servos.ReglageAcceleration, 
	senseEvitement:= , 
	zoneSelectionee:=  , 
	AU=> GVL_Base.Ix_AU_Lidar, 
	Ix_Stop_Evitement=> GVL_Servos.BpFastStop, 
	Distance_AU:=GVL_Servos.ReglageVitesse );

]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>